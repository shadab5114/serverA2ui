# Server-only overrides, loaded AFTER the repo-root .env (shared keys like OPENAI_API_KEY live there).
# Copy to server/.env. Never commit server/.env.

# Separate database from the Node backend: JS and Python checkpoints share table
# names but not formats. Create it once:  docker exec a2ui-postgres createdb -U a2ui a2ui_py
DATABASE_URL=postgresql://a2ui:a2ui@localhost:5432/a2ui_py

# AGUI_PORT=8090
# A2UI_MAX_REPAIRS=2
# ROUTER_MODEL=gpt-4o-mini

# P7 grounding. If nothing answers at MCP_URL, the backend starts this MCP server itself
# (node <script>, pointed at the same catalog.json as the validator gate) and stops it on exit.
# MCP_SERVER_SCRIPT=D:\DesignSystem\pds\mcp\catalog-server.mjs
# Design-system RAG service (open decision D2). Unset = bypassed; local guidelines/ still apply.
# RAG_URL=
# Soft-rule guideline judge (one extra model call per generated UI): on | off
# GUIDELINE_JUDGE=on
