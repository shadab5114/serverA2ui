# Shared settings for the Python backend (server/). server/.env is loaded after
# this file and overrides it (see server/.env.example for server-only keys).

# ===== LLM provider selection =====
# "openai" (default) or "anthropic" (then `uv add anthropic` in server/)
LLM_PROVIDER=openai

# ----- OpenAI -----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Router classifier (text vs ui). Falls back to OPENAI_MODEL when unset;
# a small model keeps routing fast.
ROUTER_MODEL=gpt-4o-mini
# Completion cap for UI generation.
# OPENAI_MAX_TOKENS=6000

# ----- Anthropic -----
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# ===== Server =====
# AGUI_PORT=8090
# Repair attempts after a UI fails the validator gate (0 = no retries).
# A2UI_MAX_REPAIRS=2
# Catalog source; defaults to node_modules/@shadab5114/pds-core/catalog.json
# LOCAL_CATALOG_PATH=

# ===== RAG (P7 grounding, decision D2) =====
# Design-system RAG service: POST {query, collection_name} -> {answer, citations}.
# Unset -> the RAG lookup is bypassed and only guidelines/*.md grounds the agent.
RAG_URL=http://127.0.0.1:5000/query
RAG_COLLECTION=design_system
# RAG_TIMEOUT=30  (seconds; the service writes an answer, so not 10)

# ===== MCP (P7 grounding) =====
MCP_URL=http://localhost:3939/mcp

# ===== LangGraph checkpointer =====
# Postgres for durable chat memory; unset -> in-memory (lost on restart).
# The Python backend uses its own database a2ui_py, set in server/.env.
DATABASE_URL=postgresql://a2ui:a2ui@localhost:5432/a2ui_py
